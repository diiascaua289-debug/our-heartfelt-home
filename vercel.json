{
  "rewrites": [
    {
      "source": "/painel",
      "destination": "/index.html"
    },
    {
      "source": "/painel/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/painel",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/painel/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
